{
    "name": "oprisflorentina/croogo-characterization-tests",
    "description": "HTTP-level tests that record how the Croogo app behaves, independent of its code.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/mime": "^7.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Characterization\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
