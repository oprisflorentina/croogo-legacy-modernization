{#
    The confirmation, as CakePHP's flash page showed it: the message as a link
    home, and in production mode a redirect home after one second.
#}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" /><title>{{ message }}</title>
{% if not app.debug %}
<meta http-equiv="Refresh" content="1;url={{ url }}"/>
{% endif %}
<style><!--
P { text-align:center; font:bold 1.1em sans-serif }
A { color:#444; text-decoration:none }
A:HOVER { text-decoration: underline; color:#44E }
--></style>
</head>
<body>
<p><a href="{{ url }}">{{ message }}</a></p>
</body>
</html>
